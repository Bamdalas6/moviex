# Copy to .env.local (Next.js) and .env (CLI scripts), or just run `npm run setup` after copying.

# libSQL / SQLite connection. A local file works out of the box;
# point it at Turso (libsql://<db>.turso.io) in production.
DATABASE_URL="file:./data/marquee.db"
DATABASE_AUTH_TOKEN=""

# Where uploaded posters are written. Served through /api/posters/*.
UPLOAD_DIR="./storage/uploads"

# The Movie Database API key (free: https://www.themoviedb.org/settings/api).
# With it, `npm run db:seed` / `npm run db:import-tmdb` import 100+ African films,
# official posters, streaming availability in Nigeria and the now-showing list.
TMDB_API_KEY=""

# Password for every seeded demo account (see README). Development only.
SEED_PASSWORD="marquee-demo-2026"
