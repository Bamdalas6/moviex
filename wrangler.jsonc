{
  // Cloudflare Workers config for the OpenNext build.
  // On Cloudflare Workers Builds, `npm run build` builds the Worker with OpenNext (scripts/build.mjs)
  // and `npx wrangler deploy` uploads it. Locally: `npm run cf:build` then `npm run cf:deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moviex",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Poster uploads (optional). Deploys fail if a bound bucket doesn't exist, so this is off by default.
  // To enable: create the bucket (`npx wrangler r2 bucket create moviex-posters`), then uncomment:
  // "r2_buckets": [{ "binding": "POSTERS", "bucket_name": "moviex-posters" }],

  // Non-secret settings. Secrets (DATABASE_URL, DATABASE_AUTH_TOKEN) are set in the dashboard
  // (Worker → Settings → Variables and Secrets) or with `npx wrangler secret put …` — never in this file.
  "vars": {
    "PASSWORD_ITERATIONS": "20000"
  },
  "observability": { "enabled": true }
}
