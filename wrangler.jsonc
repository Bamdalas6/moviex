{
  // Cloudflare Workers config for the OpenNext build (`npm run cf:deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moviex",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Community poster uploads. Create the bucket first: `npx wrangler r2 bucket create moviex-posters`
  "r2_buckets": [{ "binding": "POSTERS", "bucket_name": "moviex-posters" }],
  // Non-secret settings. Secrets (DATABASE_URL, DATABASE_AUTH_TOKEN) are set with
  // `npx wrangler secret put …` or in the dashboard — never in this file.
  "vars": {
    "PASSWORD_ITERATIONS": "20000"
  },
  "observability": { "enabled": true }
}
